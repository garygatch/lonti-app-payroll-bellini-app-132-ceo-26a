      "description": "",
      "name": "helpers",
      "properties": [
        {
          "body": "try {\n    const { entities: [{ Id: fetchedWorkerId, CompanyId: companyId }] } = await $ctrl.payrollApiService.get({\n        entity: \"worker\",\n        limit: 1,\n        query: `Id=${workerId}&select=Id,CompanyId`\n    });\n\n    if (fetchedWorkerId === workerId) {\n        const companyLegalName = $ctrl.globalSelectedCompany.companyMap.find(company => company.value === companyId)?.label;\n\n        if (companyId && companyLegalName && companyId !== $ctrl.globalSelectedCompany.companyId) {\n            $ctrl.utils.toast(`Switching to Worker's Company ${companyLegalName ? `(${companyLegalName})` : \"\"}`, \"INFO\");\n            $ctrl.globalSelectedCompany.setCompany(companyId, companyLegalName);\n        }\n\n        await $ctrl.loaders.loadReferenceMaps();\n        $ctrl.globalSelectedCompany.clearCompanyMenuItems();\n    }\n} catch (e) {\n    console.error(\"Failed to fetch Worker's CompanyId for automatic switching: \", e);\n}\n",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": true,
          "name": "_switchToWorkerCompany",
          "parameters": [
            "workerId"
          ],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        }
      ],
      "type": "object"
    },
    {
      "description": "",
      "name": "handlers",
      "properties": [
        {
          "body": "$ctrl.uiState.currentTab.previousId = $ctrl.uiState.currentTab.id;\n$ctrl.uiState.currentTab.id = selectedTab;\n\nif($ctrl.uiState.isPanelOpen) {\n    const discardChanges = await $ctrl.utils.handleUnsavedChanges($ctrl.uiState.isPanelOpen);\n    if (!discardChanges) {\n        $ctrl.uiState.currentTab.id = $ctrl.uiState.currentTab.previousId; \n        $ctrl.utils.setSelectedBelliniTabBarTab($ctrl.uiState.currentTab.previousId);\n        return;\n    }\n}\n\nconst entityType = $ctrl.tabItemsMap.get(selectedTab);\n\n//Update Id for worker side panel nav as it is not indexed like tab navigation\n$ctrl.uiState.currentTab.name = $ctrl.uiState.entityType = entityType;\n$ctrl.uiState.isPanelOpen = false;",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": true,
          "name": "onTabChange",
          "parameters": [
            "selectedTab"
          ],
