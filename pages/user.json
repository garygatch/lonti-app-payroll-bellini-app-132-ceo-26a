    {
      "description": "",
      "name": "loaders",
      "properties": [
        {
          "body": "// Append Font Awesome link if not already present\nif (!document.querySelector('link[href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\"]')) {\n    const link = document.createElement('link');\n    link.rel = 'stylesheet';\n    link.href = 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css';\n    document.head.appendChild(link);\n}",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "loadFontAwesome",
          "parameters": [],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "if(!$ctrl.authService.isCurrentUserAdmin) {\n    return;\n}\n\ntry {\n\n    const companyOpts = await $ctrl.referenceDataService.dropdownOptionsGetters.getOptions(\"Company\");\n\n    if ($ctrl.globalSelectedCompany) {\n        $ctrl.globalSelectedCompany.companyMap = companyOpts;\n        $ctrl.globalSelectedCompany.setMenuItems();\n    }\n    \n    // Fetch formatted options directly from service\n    const [currencyOpts, countryOpts, stateOpts, accrualOpts, earningOpts, positionOpts, payPeriodOpts] = await Promise.all([\n        $ctrl.referenceDataService.dropdownOptionsGetters.getOptions(\"Currency\"),\n        $ctrl.referenceDataService.dropdownOptionsGetters.getOptions(\"Country\"),\n        $ctrl.referenceDataService.dropdownOptionsGetters.getOptions(\"State\"),\n        $ctrl.referenceDataService.dropdownOptionsGetters.getOptions(\"Accrual\"),\n        $ctrl.referenceDataService.dropdownOptionsGetters.getOptions(\"Earning\"),\n        $ctrl.referenceDataService.dropdownOptionsGetters.getOptions(\"Position\"),\n        $ctrl.referenceDataService.dropdownOptionsGetters.getOptions(\"PayPeriod\"),\n    ]);\n\n    $ctrl.referenceData.companyMap = companyOpts;\n    $ctrl.referenceData.currencyMap = currencyOpts;\n    $ctrl.referenceData.countryMap = countryOpts;\n    $ctrl.referenceData.accrualMap = accrualOpts;\n    $ctrl.referenceData.earningMap = earningOpts;\n    $ctrl.referenceData.positionMap = positionOpts;\n    $ctrl.referenceData.payPeriodMap = payPeriodOpts;\n\n    $ctrl.referenceData.stateMap = stateOpts.reduce((acc, state) => {\n        if (!acc[state.CountryId]) acc[state.CountryId] = [];\n        acc[state.CountryId].push(state);\n        return acc;\n    }, {});\n\n} catch (e) {\n    console.warn(\"Background reference load failed\", e);\n}",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": true,
          "name": "loadReferenceMaps",
          "parameters": [],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "$ctrl.uiState.workerNavs = [\n    {\n        label: \"User\",\n        evaluateLabel: false,\n        onClick: \"function\",\n        function: () => $ctrl.handlers.onTabChange(1),  \n    },\n    {\n        label: \"Worker\",\n        evaluateLabel: false,\n        onClick: \"function\",\n        function: () => $ctrl.handlers.onTabChange(2),  \n    },\n    {  \n        label: \"Employment Info\",\n        evaluateLabel: false,\n        onClick: \"function\",\n        function: () => $ctrl.handlers.onTabChange(3),  \n    },\n    {\n        label: \"Bank Info\",\n        evaluateLabel: false,\n        onClick: \"function\",\n        function: () => $ctrl.handlers.onTabChange(4),  \n    },\n    {\n        label: \"Statutory Compliance\",\n        evaluateLabel: false,\n        onClick: \"function\",\n        function: () => $ctrl.handlers.onTabChange(5),  \n    },\n    {   label: \"Leave Credits\",\n        evaluateLabel: false,\n        onClick: \"function\",\n        function: () => $ctrl.handlers.onTabChange(6),  \n    },\n    // Disabled until non admin users get access to Earning/Benefit Scope\n    // {\n    //     label: \"Pay Component\",\n    //     evaluateLabel: false,\n    //     onClick: \"function\",\n    //     function: () => $ctrl.handlers.onTabChange(7),  \n    // },\n    {\n        label: \"Attendance Summary\",\n        evaluateLabel: false,\n        onClick: \"function\",\n        function: () => $ctrl.handlers.onTabChange(8),  \n    },\n    {\n        label: \"Pay Slip\",\n        evaluateLabel: false,\n        onClick: \"function\",\n        function: () => $ctrl.handlers.onTabChange(9),  \n    },\n    {\n        label: \"YTD\",\n        evaluateLabel: false,\n        onClick: \"function\",\n        function: () => $ctrl.handlers.onTabChange(10),  \n    }\n];",
