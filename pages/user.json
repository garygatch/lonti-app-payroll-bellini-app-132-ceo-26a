          },
          "type": "method",
          "watch": []
        },
        {
          "body": "$ctrl.authCookies.setServerUrl($ctrl.$env.getProperty(\"payroll_api_base_url\"));\nawait $ctrl.authService.authReadyPromise; \n\nif(!$ctrl.pageParameters.userId && $ctrl.authService.isCurrentUserAdmin) {\n    if($ctrl.$env.current.name !== \"local\") {\n        $ctrl.utils.toast(`UserID not Found`, \"ERROR\");\n        $ctrl.$state.go(\"people_management\");\n    }\n}\n\n$ctrl.uiState.links = [\n    {\n        label: \"People Management\",\n        active: false,\n        onClick: \"function\",\n        function: () => $ctrl.handlers.onNavigateToPeopleManagement()\n    }\n]\n\nif(!$ctrl.authService.isCurrentUserAdmin) {\n    $ctrl.$state.go(\"user\", { userId: $ctrl.authService.saasAuth.userId }, { location: 'replace', notify: false });\n    $ctrl.pageParameters.userId = $ctrl.authService.saasAuth.userId;\n    $ctrl.uiState.workerId = $ctrl.authService.saasAuth.workerId;\n} else {\n    $ctrl.uiState.workerId = await $ctrl.authService.getUserWorkerId($ctrl.pageParameters.userId);\n}\n\n$ctrl.uiState.userId = $ctrl.pageParameters.userId;\nawait $ctrl.loaders.loadReferenceMaps();\n\nif($ctrl.uiState.workerId && $ctrl.authService.isCurrentUserAdmin) {\n    await $ctrl.helpers._switchToWorkerCompany($ctrl.uiState.workerId);\n}\n\n\n\n$ctrl.loaders.loadFontAwesome();\n$ctrl.loaders.loadWorkerNavTabs();\n",
          "description": "",
          "invokeOnLoad": true,
          "isAsync": true,
          "name": "onInit",
          "parameters": [],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "if($ctrl.uiState.isPanelOpen) {\n    const confirmed = await $ctrl.utils.handleUnsavedChanges($ctrl.uiState.isPanelOpen);\n    if (!confirmed) return;\n}\n\n$ctrl.$state.go(\"people_management\", $ctrl.pageParameters.retainPage ? { page: $ctrl.pageParameters.retainPage } : {});",
