          "body": "$ctrl.result = 'ok';\nconst noValueOps = ['isnull', 'isnotnull'];\nconst validFilters = $ctrl.privateStateVars.filters.filter(f => {\n    \n    // Rule A: Property is always required\n    if (!f.property) return false;\n\n    // Rule B: If operation is \"Is Null\" / \"Is Not Null\", it's valid (Value ignored)\n    if (f.operation && noValueOps.includes(f.operation.toLowerCase())) {\n        return true;\n    }\n\n    // Rule C: For standard operations (Equals, Contains), Value is required\n    return $ctrl.helpers.hasValidValue(f.value);\n});\n\n$ctrl.resolve.filters = validFilters;\n$ctrl.onClose();",
