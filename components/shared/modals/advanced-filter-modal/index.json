          "body": "if (!filterRow.property) return $ctrl.en.modals.advancedFilterModal.dropdowns.FILTER_OPERATION.values;\nconst def = $ctrl.privateStateVars.definitions.find(def => def.value === filterRow.property);\nlet operators;\n\nif (def && def?.operators) {\n    operators = def.operators.map(op => ({\n        label: $ctrl.en.modals.advancedFilterModal.dropdowns.FILTER_OPERATION.values.find(v => v.value === op)?.label || op,\n        value: op\n    }));\n\n    filterRow.operation = operators[0]?.value || null;\n} else {\n    operators = $ctrl.en.modals.advancedFilterModal.dropdowns.FILTER_OPERATION.values;\n}\n\nreturn operators;",
