      "body": "$ctrl.privateStateVars.title = $ctrl.resolve?.title ?? \"Items\";\n\n$ctrl.privateStateVars.search.property = $ctrl.resolve?.search?.property;\n$ctrl.privateStateVars.search.operation = $ctrl.resolve?.search?.operation;\n$ctrl.privateStateVars.search.placeholder = $ctrl.resolve?.search?.placeholder ?? `Search by: ${$ctrl.resolve?.search?.operation} ${$ctrl.resolve?.search?.property}`;\n$ctrl.privateStateVars.search.fn = $ctrl.resolve?.search?.fn;\n\n$ctrl.privateStateVars.assigned.columns = $ctrl.resolve?.assigned?.columns ?? [{ name: \"Name\", valueKey: \"Name\" }];\n$ctrl.privateStateVars.assigned.items = angular.copy($ctrl.resolve?.assigned?.items) ?? [];\n$ctrl.privateStateVars.assigned.ids = new Set ($ctrl.privateStateVars.assigned.items.map(i => i.Id));\n$ctrl.privateStateVars.assigned.results = angular.copy($ctrl.resolve?.assigned?.items) ?? [];\n$ctrl.privateStateVars.assigned.pagination.totalPages = $ctrl.privateStateVars.assigned.items.length > 0 ? Math.ceil($ctrl.privateStateVars.assigned.items.length / 25) : 1;\n\n$ctrl.privateStateVars.unassigned.columns = $ctrl.resolve?.unassigned?.columns ?? [{ name: \"Name\", valueKey: \"Name\" }];\n$ctrl.privateStateVars.unassigned.items = angular.copy($ctrl.resolve?.unassigned?.items) ?? [];\n$ctrl.privateStateVars.unassigned.results = angular.copy($ctrl.resolve?.unassigned?.items) ?? [];\n$ctrl.privateStateVars.unassigned.pagination.totalPages = $ctrl.resolve?.unassigned?.pagination?.totalPages > 0 ? $ctrl.resolve?.unassigned?.pagination?.totalPages  : 1;\n$ctrl.privateStateVars.unassigned.pagination.fn = $ctrl.resolve?.unassigned?.pagination?.fn;",
