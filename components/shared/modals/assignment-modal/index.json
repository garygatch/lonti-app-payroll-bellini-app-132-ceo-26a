      "properties": [
        {
          "body": "$ctrl.applied = true;\n$ctrl.resolve.assignedItems = $ctrl.privateStateVars.assigned.items;\n$ctrl.resolve.assignedIds = $ctrl.privateStateVars.assigned.ids;\n$ctrl.onClose()",
