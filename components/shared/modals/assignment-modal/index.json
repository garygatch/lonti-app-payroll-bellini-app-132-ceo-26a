        {
          "body": "$ctrl.privateStateVars.assigned.items.push(item);\n$ctrl.privateStateVars.assigned.ids.add(item.Id);\n\nif ($ctrl.helpers.shouldAddBack(item, $ctrl.privateStateVars.assigned.query)) {\n    $ctrl.privateStateVars.assigned.results.push(item);\n}\n\n$ctrl.helpers._updatePageCount($ctrl.privateStateVars.assigned);\n\nconst unassignedResults = $ctrl.privateStateVars.unassigned.results;\nconst idx = unassignedResults.findIndex(x => x.Id === item.Id);\n\nif (idx > -1) {\n    unassignedResults.splice(idx, 1);\n}\n\nconst unassignedResultsLength = unassignedResults.length;\nconst unassignedCurrentPage = $ctrl.privateStateVars.unassigned.pagination.currentPage;\nlet pageToRequest = 1;\n\nif (unassignedResultsLength > 0) {\n    pageToRequest = unassignedCurrentPage;\n} else {\n    if (unassignedCurrentPage > 1) {\n        pageToRequest = unassignedCurrentPage - 1;\n    }\n}\n\n$ctrl.handlers.onUnassignedPageChange(pageToRequest);",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "onAssign",
          "parameters": [
            "item"
          ],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "const idx = $ctrl.privateStateVars.assigned.items.findIndex(x => x.Id === item.Id);\n\nif (idx > -1) {\n    $ctrl.privateStateVars.assigned.items.splice(idx, 1);\n    $ctrl.handlers.onAssignedSearch();\n}\n\n$ctrl.privateStateVars.assigned.ids.delete(item.Id);\n\nif ($ctrl.helpers.shouldAddBack(item, $ctrl.privateStateVars.unassigned.query)) {\n    $ctrl.privateStateVars.unassigned.results.push(item);\n    $ctrl.handlers.onUnassignedPageChange($ctrl.privateStateVars.unassigned.pagination.currentPage);\n}\n\n$ctrl.helpers._updatePageCount($ctrl.privateStateVars.assigned);",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "onUnassign",
          "parameters": [
            "item"
          ],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "const query = $ctrl.privateStateVars.assigned.query ?? \"\";\n\nif (query.trim().length > 0) {\n  $ctrl.privateStateVars.assigned.results = $ctrl.privateStateVars.assigned.items.filter(item =>\n    item[$ctrl.privateStateVars.search.property].toLowerCase().includes(query.trim().toLowerCase())\n  );\n} else {\n  $ctrl.privateStateVars.assigned.results = [...$ctrl.privateStateVars.assigned.items];\n}",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "onAssignedSearch",
          "parameters": [],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "$ctrl.privateStateVars.unassigned.pagination.fn(currentPage, $ctrl.privateStateVars.unassigned.query, $ctrl.privateStateVars.assigned).then(res => {\n    const { entities, metadata: { currentPage, pageCount } } = res;\n    $ctrl.privateStateVars.unassigned.results = entities.filter(item => !$ctrl.privateStateVars.assigned.ids.has(item.Id));\n    $ctrl.privateStateVars.unassigned.pagination.currentPage = currentPage || 1;\n    $ctrl.privateStateVars.unassigned.pagination.totalPages = pageCount || 1;\n});",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "onUnassignedPageChange",
          "parameters": [
            "currentPage"
          ],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "$ctrl.privateStateVars.search.fn($ctrl.privateStateVars.unassigned.query, $ctrl.privateStateVars.assigned).then(res => {\n    const { entities, metadata: { pageCount } } = res;\n    $ctrl.privateStateVars.unassigned.results = entities.filter(item => !$ctrl.privateStateVars.assigned.ids.has(item.Id));\n    $ctrl.privateStateVars.unassigned.pagination.currentPage = 1;\n    $ctrl.privateStateVars.unassigned.pagination.totalPages = pageCount > 0 ? pageCount : 1;\n});",
          "description": "",
