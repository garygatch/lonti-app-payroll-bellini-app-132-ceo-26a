          },
          "type": "method",
          "watch": []
        },
        {
          "body": "const targetArray = targetObj.results;\n\nif (!Array.isArray(targetArray)) {\n    console.error(\"Failed to update page count for assignment modal.\");\n    return;\n}\n\nconst ITEMS_PER_PAGE = 25;\nconst arrLength = targetArray.length || 1;\n\ntargetObj.pagination.totalPages = Math.ceil(arrLength / ITEMS_PER_PAGE);\n\nif (targetObj.pagination.currentPage > targetObj.pagination.totalPages) {\n    targetObj.pagination.currentPage -= 1;\n}",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "_updatePageCount",
          "parameters": [
            "targetObj"
          ],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        }
      ],
      "type": "object"
    }
  ]
}
