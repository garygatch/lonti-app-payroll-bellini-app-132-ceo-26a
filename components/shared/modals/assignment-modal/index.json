      "properties": [
        {
          "body": "if (!query) return true;\n\nconst textToMatch = (item[$ctrl.privateStateVars.search.property] ?? \"\").toLowerCase();\nreturn textToMatch.includes(query.toLowerCase());",
          "description": "",
