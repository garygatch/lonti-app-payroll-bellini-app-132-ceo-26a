    {
      "description": "",
      "name": "handlers",
      "properties": [
        {
          "body": "const availableMode = $ctrl.uiState.ytd.viewingModes.some(mode => mode.value === viewingMode) ? viewingMode : \"SUMMARY\";\n$ctrl.uiState.ytd.viewingMode = availableMode;\nlet toDisplay = $ctrl.uiState.ytd[availableMode];\n\nif (Array.isArray(toDisplay)) {\n    toDisplay = toDisplay.reduce((acc, item) => {\n        if (item.Name) {\n            acc[item.Name] = {\n                value: item.YtdEmployeeAmount || 0,\n                value2: item.YtdEmployerAmount || 0\n            };\n        }\n        return acc;\n    }, {});\n}\n\n$ctrl.helpers._setDisplayedInfo(toDisplay);",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "onYtdViewingModeChange",
          "parameters": [
            "viewingMode"
          ],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "if ($ctrl.uiState.ytd.isSpanningFiscalYear && $ctrl.uiState.ytd.startFiscalDate) {\n    $ctrl.uiState.ytd.endFiscalDate = $ctrl.helpers._calculateNewEndFiscalYear();\n} else {\n    $ctrl.uiState.ytd.endFiscalDate = undefined;\n}\n\nawait $ctrl.loaders.loadProfileTabContent({ fiscalDate: $ctrl.uiState.ytd.startFiscalDate });",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": true,
          "name": "onSpanningFiscalYearToggle",
          "parameters": [],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        }
      ],
      "type": "object"
    },
    {
      "description": "",
      "name": "loaders",
      "properties": [
        {
          "body": "$ctrl.helpers._resetProfileYtd();\n\nif (!fiscalDate) {\n    if (currentRequestId === $ctrl.uiState.currentRequestId) {\n        $ctrl.uiState.ytd.endFiscalDate = undefined;\n        $ctrl.isLoadingTable = false;\n        $ctrl.uiState.ytd.isFirstLoad = false;\n    }\n    return;\n}\n\nlet startFiscalYear = String(fiscalDate?.getFullYear());\n\nif ($ctrl.uiState.ytd.isFirstLoad) {\n    startFiscalYear = String($ctrl.uiState.ytd.startFiscalDate?.getFullYear());\n    $ctrl.uiState.ytd.isFirstLoad = false;\n}\n\nlet fiscalYear = startFiscalYear;\n\nif ($ctrl.uiState.ytd.isSpanningFiscalYear && startFiscalYear) {\n    $ctrl.uiState.ytd.endFiscalDate = $ctrl.helpers._calculateNewEndFiscalYear(fiscalDate);\n    fiscalYear = startFiscalYear.concat(\"-\", String($ctrl.uiState.ytd.endFiscalDate?.getFullYear()));\n}\n\n$ctrl.payrollAppApi.lonti_app_payroll_service_reporting_GetWorkerYtdSummary({\n    workerId: $ctrl.workerId,\n    fiscalYear: fiscalYear\n}, {\n    headers: $ctrl.authCookies.setHeaders()\n}).then((res) => {\n    const { data: { ytdSummary, ytdComponents } } = res;\n\n    if (currentRequestId !== $ctrl.uiState.currentRequestId) return;\n\n    $ctrl.uiState.ytd.SUMMARY = ytdSummary;\n\n    if (ytdComponents && Array.isArray(ytdComponents) && ytdComponents.length > 0) {\n        ytdComponents.forEach((component) => {\n            const componentClass = component.ComponentClass;\n\n            if (!$ctrl.uiState.ytd.hasOwnProperty(componentClass)) {\n                $ctrl.uiState.ytd[componentClass] = [];\n\n                $ctrl.uiState.ytd.viewingModes = [\n                    ...$ctrl.uiState.ytd.viewingModes,\n                    {\n                        label: componentClass,\n                        value: componentClass\n                    }\n                ];\n            }\n\n            $ctrl.uiState.ytd[componentClass].push(component);\n        });\n    }\n\n    $ctrl.handlers.onYtdViewingModeChange($ctrl.uiState.ytd.viewingMode);\n\n}).catch((e) => {\n}).finally(() => {\n    if (currentRequestId === $ctrl.uiState.currentRequestId) {\n        $ctrl.isLoadingTable = false;\n    }\n})",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": true,
          "name": "loadWorkerYtdSummary",
          "parameters": [
            "currentRequestId",
            "fiscalDate"
          ],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "if (!params) params = {};\n\nconst entityType = $ctrl.entityType;\n$ctrl.uiState.currentRequestId++;\nconst currentRequestId = $ctrl.uiState.currentRequestId;\n$ctrl.isLoadingTable = true;\n\n$ctrl.helpers._resetUiState(true);\n\nif (!$ctrl.isWorker || !$ctrl.workerId) {\n    if (currentRequestId === $ctrl.uiState.currentRequestId) {\n        $ctrl.isLoadingTable = false;\n    }\n    return;\n}\n\ntry {\n    if(!params.fiscalDate) {\n        params.fiscalDate = $ctrl.uiState.ytd.startFiscalDate;\n    }\n\n    await $ctrl.loaders.loadWorkerYtdSummary(currentRequestId, params.fiscalDate);\n} catch (err) {\n    // Only show the error if user is still on the tab that failed\n    if (currentRequestId === $ctrl.uiState.currentRequestId) {\n        console.error(err);\n        $ctrl.utils.toast(`Failed to load ${entityType} data`, \"ERROR\");\n    }\n    \n}",
          "description": "",
          "invokeOnLoad": true,
          "isAsync": true,
          "name": "loadActiveTab",
          "parameters": [
            "params"
          ],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": [
            "$ctrl.entityType",
            "$ctrl.reloadTab"
          ]
        }
      ],
      "type": "object"
    },
    {
      "description": "",
      "name": "helpers",
      "properties": [
        {
          "body": "// Items to persist\nconst viewingMode = $ctrl.uiState.ytd.viewingMode;\nconst startFiscalDate = $ctrl.uiState.ytd.startFiscalDate;\nconst endFiscalDate = $ctrl.uiState.ytd.endFiscalDate;\nconst isSpanningFiscalYear = $ctrl.uiState.ytd.isSpanningFiscalYear;\nconst isFirstLoad = $ctrl.uiState.ytd.isFirstLoad;\n\n// Reset\n$ctrl.uiState.ytd = {};\n$ctrl.uiState.ytd.SUMMARY = {};\n$ctrl.uiState.ytd.viewingModes = [\n    {\n        label: \"SUMMARY\",\n        value: \"SUMMARY\"\n    }\n];\n\n// Persist\n$ctrl.uiState.ytd.viewingMode = viewingMode;\n$ctrl.uiState.ytd.startFiscalDate = startFiscalDate;\n$ctrl.uiState.ytd.endFiscalDate = endFiscalDate;\n$ctrl.uiState.ytd.isSpanningFiscalYear = isSpanningFiscalYear;\n$ctrl.uiState.ytd.isFirstLoad = isFirstLoad;",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "_resetProfileYtd",
          "parameters": [],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "try {\n    const startDate = new Date(fiscalDate ?? $ctrl.profileUiState?.ytd?.startFiscalDate);\n\n    // Clone start date to avoid mutating the original\n    const endDate = new Date(startDate);\n    endDate.setFullYear(endDate.getFullYear() + 1);\n\n    return endDate;\n} catch (e) {\n    throw e;\n}",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "_calculateNewEndFiscalYear",
          "parameters": [
            "fiscalDate"
          ],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "const tabConfig = $ctrl.tabConfig[$ctrl.entityType];\n$ctrl.uiState.displayedInfo = $ctrl.helpers._generateAndMaskDetailsList(data, tabConfig);",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "_setDisplayedInfo",
          "parameters": [
