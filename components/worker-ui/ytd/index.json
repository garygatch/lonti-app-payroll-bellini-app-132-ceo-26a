        {
          "body": "$ctrl.uiState.selectedEntity = null;\n$ctrl.uiState.selectedEntityName = \"\";\n\n$ctrl.uiState.displayedInfo = [];\n$ctrl.uiState.detailsList = [];\n\nif (resetTabStore && $ctrl.tabStore[$ctrl.entityType]) {\n    $ctrl.tabStore[$ctrl.entityType].data = [];\n}",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "_resetUiState",
          "parameters": [
            "resetTabStore"
          ],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "if (!data) return [];\n\nconst detailsList = $ctrl.entityViewService.generateDetailsList(data);\n\nif (tabConfig?.containsSensitiveInfo && tabConfig?.sensitiveInfoFields) {\n    return $ctrl.helpers._maskSensitiveInfo(tabConfig.sensitiveInfoFields, detailsList);\n}\n\nreturn detailsList;",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "_generateAndMaskDetailsList",
          "parameters": [
            "data",
            "tabConfig"
          ],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "const sensitiveFieldsSet = new Set(sensitiveInfoFields);\nreturn detailsList.map(item => {\n    if (item.isSpacer || !sensitiveFieldsSet.has(item.originalKey)) {\n        return item;\n    }\n\n    const strValue = String(item.value || \"\");\n    const maskedValue = \"*\".repeat(strValue.length);\n\n    return {\n        ...item,\n        originalValue: item.value,\n        value: maskedValue, // Default to maskedValue for sensitive info\n        maskedValue: maskedValue,\n        isMasked: true\n    };\n});",
          "description": "",
          "invokeOnLoad": false,
          "isAsync": false,
          "name": "_maskSensitiveInfo",
          "parameters": [
            "sensitiveInfoFields",
            "detailsList"
          ],
          "returnType": {
            "name": "any"
          },
          "type": "method",
          "watch": []
        },
        {
          "body": "const startFiscalDate = $ctrl.uiState.ytd?.startFiscalDate;\n\nconst year = startFiscalDate\n    ? (startFiscalDate instanceof Date ? startFiscalDate.getFullYear() : startFiscalDate)\n    : null;\n\nlet msg;\n\nif (!startFiscalDate) {\n    msg = \"Select a valid year to get started.\";\n} else {\n    msg = `Looks like there's no data for year ${year}.`;\n    if($ctrl.authService.isCurrentUserAdmin) {\n        msg += ` Go to Payroll Processing page to get started.`\n    }\n}\n\nreturn msg;",
