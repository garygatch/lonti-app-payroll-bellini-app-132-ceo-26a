    {
      "body": "$ctrl.result = 'cancel'\n$ctrl.onClose()",
      "description": "This function is called when Cancel button is clicked.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onCancelClick",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "const previewBox = document.getElementById(\"confirm-preview\");\nconst errorDisplay = document.getElementById(\"errors-and-warnings\");\n\nif ($ctrl.props?.PreviewData) {\n    const maxLines = 100;\n    renderTable($ctrl.props.PreviewData, $ctrl.props.DataLength > maxLines);\n} else {\n    if (previewBox) previewBox.innerHTML = ``;\n    if (errorDisplay) errorDisplay.innerHTML = ``;\n    if ($ctrl.hasErrors) delete $ctrl.hasErrors;\n}\n\nfunction renderTable(data, isTruncated) {\n    if (!data || data.length === 0) {\n        previewBox.innerHTML = \"<p>No data to display.</p>\";\n        return;\n    }\n\n    // Create table element\n    let table = `<table style=\"width: 100%; \">`;\n    table += \"<thead><tr>\";\n\n    // Add header row\n    data[0].forEach(header => {\n        table += `<th style=\"text-align: left; \">${header}</th>`;\n    });\n    table += \"</tr></thead>\";\n\n    // Add data rows\n    table += \"<tbody>\";\n    for (let i = 1; i < data.length; i++) {\n        table += \"<tr>\";\n        data[i].forEach(cell => {\n            table += `<td style=\"text-align: left; \">${cell}</td>`;\n        });\n        table += \"</tr>\";\n    }\n    table += \"</tbody></table>\";\n\n    // Add truncation message if applicable\n    if (isTruncated) {\n        table += \"<p>... (preview truncated)</p>\";\n    }\n\n    waitForElementAndInject(table);\n}\n\nfunction waitForElementAndInject(table) {\n    let element = document.getElementById(\"confirm-preview\");\n\n    if (element) {\n        element.innerHTML = table;\n    } else {\n        $ctrl.$timeout(waitForElementAndInject(table), 100);\n    }\n}",
      "description": "",
      "invokeOnLoad": true,
      "isAsync": false,
      "name": "handleFileImport",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": [
        "$ctrl.props.PreviewData"
      ]
    }
  ]
