  "variables": [
    {
      "body": "$ctrl.exportAsCSV();\n$ctrl.result = 'ok'\n$ctrl.onClose()",
      "description": "This function is called when OK button is clicked.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onOkClick",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "$ctrl.result = 'cancel'\n$ctrl.onClose()",
      "description": "This function is called when Cancel button is clicked.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onCancelClick",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "exportDivAsCSV(\"sample-csv\", \"sample-attendance\");\n\nfunction exportDivAsCSV(divId, fileName) {\n    // Get the div element\n    const divElement = document.getElementById(divId);\n    if (!divElement) {\n        console.error(`Div with ID '${divId}' not found`);\n        return;\n    }\n\n    // Collect text content from <p> elements\n    const paragraphs = divElement.querySelectorAll('p');\n    const csvRows = [];\n    paragraphs.forEach((p) => {\n        // Add the text content of each <p> to a new row in the CSV (no quotes)\n        csvRows.push(p.textContent.trim());\n    });\n\n    // Combine rows into a single CSV string\n    const csvContent = csvRows.join('\\n');\n\n    // Create a Blob from the CSV string\n    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });\n\n    // Create a download link\n    const link = document.createElement('a');\n    const url = URL.createObjectURL(blob);\n    link.setAttribute('href', url);\n    link.setAttribute('download', `${fileName || 'data'}.csv`);\n    document.body.appendChild(link);\n\n    // Trigger the download and clean up\n    link.click();\n    document.body.removeChild(link);\n    URL.revokeObjectURL(url);\n}\n",
      "description": "",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "exportAsCSV",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    }
  ]
