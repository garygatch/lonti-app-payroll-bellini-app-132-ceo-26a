  "children": [
    {
      "children": [
        {
          "children": [
            {
              "evaluate": true,
              "name": "text",
              "textContent": "\"Delete \" + $ctrl.props.EntityName + \"?\""
            }
          ],
          "classList": [
            "modal-title"
          ],
          "name": "div"
        },
        {
          "children": [
