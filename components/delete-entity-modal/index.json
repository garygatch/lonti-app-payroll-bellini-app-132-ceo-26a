          "expressions": [
            {
              "expression": "\"primary\"",
              "to": "type"
            },
            {
              "expression": "$ctrl.props.EntityName ? \"Yes, Delete \" + $ctrl.props.EntityName : \"Yes, Delete It\"",
              "to": "label"
            },
            {
              "expression": "$ctrl.onOkClick()",
              "to": "onClick"
            }
          ],
          "name": "Button",
          "nodeName": "bln-button",
          "styles": [
            {
              "enabled": true,
