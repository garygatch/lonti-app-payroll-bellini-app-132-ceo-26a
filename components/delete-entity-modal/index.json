          "attributes": [
            {
              "property": "core",
              "value": ""
            }
          ],
          "children": [],
          "classList": [
            "btn-cancel"
          ],
          "expressions": [
            {
              "expression": "\"secondary\"",
              "to": "type"
            },
            {
              "expression": "'Cancel'",
              "to": "label"
            },
            {
              "expression": "$ctrl.onCancelClick()",
              "to": "onClick"
            }
          ],
          "name": "Button",
